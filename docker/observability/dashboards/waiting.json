{
  "title": "waiting — 게이트웨이",
  "uid": "waiting-gateway",
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "판정 분포",
      "description": "무엇이 통과하고 무엇이 줄로 갔는지. 한산한 쿠폰이 줄로 가기 시작하면 R1 이 뒤집힌 것이다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(waiting_admission_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "대기 인원과 재료 나이",
      "description": "둘을 함께 본다. 대기 인원은 갱신에 실패해도 마지막 값을 계속 내므로, 나이가 없으면 '안정적으로 2만 명' 과 '몇 분째 못 보고 있음' 이 같은 그림이 된다. 나이가 -1 이면 재료를 한 번도 못 받은 것이다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "waiting_queue_waiting and on(instance) (waiting_snapshot_age >= 0 and waiting_snapshot_age <= 5)",
          "legendFormat": "대기 인원 (재료가 신선할 때만)"
        },
        {
          "expr": "waiting_snapshot_age",
          "legendFormat": "재료 나이(초)"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "뒷단 유입 RPS",
      "description": "게이트웨이가 실제로 뒷단에 흘린 양. 배분된 크레딧과 나란히 보면 조절이 도는지 알 수 있다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(spring_cloud_gateway_requests_seconds_count{routeId=\"issue\"}[1m]))",
          "legendFormat": "발급 유입"
        },
        {
          "expr": "waiting_capacity_credit",
          "legendFormat": "전역 크레딧"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "보호 장치가 막은 양",
      "description": "서킷·격벽·fail-open 이 각각 얼마나 막았는지. 폴백은 서킷이 열렸을 때만 오는 것이 아니므로 상태 라벨과 함께 본다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (state) (rate(waiting_backend_fallback_total[1m]))",
          "legendFormat": "폴백 {{state}}"
        },
        {
          "expr": "sum(rate(waiting_admission_total{outcome=~\"bulkhead-full|bulkhead-timeout\"}[1m]))",
          "legendFormat": "격벽 (참 + 시한)"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "장애 전이 타임라인",
      "description": "진입과 해제가 쌍으로 남는다 (LG-2). 지표는 초 단위로 뭉개져 '몇 시 몇 분에 열려 얼마나 갔는가' 를 못 답한다.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{app=\"waiting\"} |~ `서킷 (열림|닫힘)|fail-open (진입|해제)|종료 시작` "
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "ERROR",
      "description": "사람을 부르는 줄만 남는다. 자동으로 걷히는 전이는 WARN 이라 여기 안 온다 (LG-7).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{app=\"waiting\", level=\"ERROR\"}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "조회 모으기",
      "description": "모은 것과 못 모은 것. cause 가 왜 안 모였는지를 답한다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "sum by (outcome, cause) (rate(waiting_coalescing_total[1m]))",
          "legendFormat": "{{outcome}}/{{cause}}"
        },
        {
          "expr": "waiting_coalescing_cached",
          "legendFormat": "담고 있는 키 수 (상한에 닿으면 모으기가 멎는다)"
        },
        {
          "expr": "waiting_coalescing_bytes",
          "legendFormat": "담고 있는 바이트 (예산에 닿으면 모으기가 멎는다)"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "격벽 포화",
      "description": "막은 횟수는 이미 막힌 뒤에야 오른다. 차오르는 중인지를 본다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "waiting_bulkhead_inflight",
          "legendFormat": "{{instance}} — 걸려 있는 요청"
        },
        {
          "expr": "waiting_bulkhead_coupons",
          "legendFormat": "{{instance}} — 자리를 쥔 쿠폰"
        },
        {
          "expr": "waiting_bulkhead_max_coupons",
          "legendFormat": "{{instance}} — 담을 수 있는 쿠폰 (분모)"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "적용 중인 운영 값",
      "description": "배포 없이 바꾼 값이 닿았는지를 본다. -1 은 안 실려 온 것 (기동값으로 도는 중)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "waiting_tunable_idle_ratio",
          "legendFormat": "{{instance}} — 한산 몫"
        },
        {
          "expr": "waiting_tunable_inflight_seconds",
          "legendFormat": "{{instance}} — 걸림 시간(초)"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "불변식 선행 지표",
      "description": "초과 발급과 순번 역행은 게이트웨이가 직접 못 본다. 스스로 계산한 값으로 대신 본다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "increase(waiting_allocation_budget_overshoot_total[5m])",
          "legendFormat": "{{instance}} — 예산 초과(평활 지연·하한)"
        },
        {
          "expr": "increase(waiting_allocation_entered_overshoot_total[5m])",
          "legendFormat": "{{instance}} — 초과 입장(직접 증거)"
        },
        {
          "expr": "increase(waiting_snapshot_clock_floor_applied_total[5m])",
          "legendFormat": "{{instance}} — 재료 시각 역행"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "매진 관찰",
      "description": "뒷단이 낸 매진을 노드가 기억한 횟수. 상한에 닿으면 새 관찰을 못 받고 그때부터 뒷단이 다시 다 맞는다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(waiting_soldout_observed_total[1m]))",
          "legendFormat": "관찰 {{result}} (already 가 계속 오르면 방패가 안 듣는다)"
        },
        {
          "expr": "sum(rate(waiting_soldout_cache_hit_total[1m]))",
          "legendFormat": "캐시가 끊은 것"
        },
        {
          "expr": "waiting_soldout_cache_size",
          "legendFormat": "담고 있는 쿠폰 수"
        },
        {
          "expr": "waiting_soldout_cache_capacity",
          "legendFormat": "상한 (닿으면 새 관찰을 못 받는다)"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "본문 시한",
      "description": "헤더는 왔는데 본문이 안 끝나는 뒷단. 구간 수와 끊은 건수를 같이 본다 — 만 건이 한 번의 장애인지 천 번인지는 건수로 못 가른다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "expr": "sum(rate(waiting_backend_body_cut_total[1m]))",
          "legendFormat": "끊은 건수"
        },
        {
          "expr": "sum(increase(waiting_backend_body_episode_total[5m]))",
          "legendFormat": "구간 수 (5분)"
        }
      ]
    }
  ]
}
