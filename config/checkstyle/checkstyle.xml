<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  식별자는 ASCII 영문이다. 한글은 주석·Javadoc·로그 메시지에만 쓴다.

  **직접 짜지 않는다.** 이 판정은 주석·문자열·텍스트 블록을 가려내고 유니코드
  이스케이프까지 다뤄야 하는데, 그건 파서가 하는 일이다. 손으로 쓴 정규식은
  어노테이션·수식어·줄바꿈이 조금만 달라도 새거나 반대로 무관한 것을 문다.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="TreeWalker">
        <!-- 이름 규칙. format 이 ASCII 만 허용하므로 한글 식별자가 걸린다. -->
        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
        </module>
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="StaticVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <!-- 로거는 상수지만 관례가 소문자다. 이름 짓기 규칙이 아니라
             식별자가 ASCII 영문인지를 보는 것이 목적이라 함께 허용한다. -->
        <module name="ConstantName">
            <property name="format" value="^([A-Z][A-Z0-9]*(_[A-Z0-9]+)*|log)$"/>
        </module>
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="LocalFinalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="LambdaParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="CatchParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="RecordComponentName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="ClassTypeParameterName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
        </module>
        <module name="MethodTypeParameterName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
        </module>
        <module name="InterfaceTypeParameterName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
        </module>
        <module name="RecordTypeParameterName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
        </module>

        <!-- 위 모듈들이 안 보는 자리 — 패턴 변수, enum 상수, 어노테이션 멤버.
             종류별로 모듈을 늘리는 대신 여기서 한 번에 막는다. -->
        <module name="IllegalIdentifierName">
            <property name="format" value="^[a-zA-Z_$][a-zA-Z0-9_$]*$"/>
        </module>

        <!-- 유니코드 이스케이프는 렉싱 전에 풀려 토큰 경계를 바꾼다. -->
        <module name="IllegalTokenText">
            <property name="tokens" value="STRING_LITERAL, CHAR_LITERAL"/>
            <property name="format" value="\\u00(08|09|0(a|A)|0(c|C)|0(d|D)|22|27|5(C|c))|\\(0(10|11|12|14|15|42|47)|134)"/>
            <property name="message" value="유니코드 이스케이프는 쓰지 않는다 — 렉싱 전에 풀려 토큰 경계를 바꾼다"/>
        </module>
        <module name="AvoidEscapedUnicodeCharacters">
            <property name="allowEscapesForControlCharacters" value="false"/>
            <property name="allowNonPrintableEscapes" value="false"/>
        </module>
    </module>
</module>
